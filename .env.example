APP_NAME="AI Kino 2.0"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=uz
APP_FALLBACK_LOCALE=ru

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=aikino
DB_USERNAME=postgres
DB_PASSWORD=secret

QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Telegram Bot & Mini App Configuration
TELEGRAM_BOT_TOKEN="YOUR_BOT_TOKEN_HERE"
TELEGRAM_BOT_USERNAME="aikino_bot"
TELEGRAM_WEBHOOK_SECRET="random_secure_secret_token"
TELEGRAM_STORAGE_CHAT_ID="-1001234567890"

# Telegram Stars (Digital goods: provider_token is empty for XTR)
TELEGRAM_STARS_CURRENCY="XTR"

# Mini App URL
MINI_APP_URL="https://aikino.app"
